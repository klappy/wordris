{
	"name": "biblical-word-tetris",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "A Tetris-like word game using Bible verses with falling letters and word formation",
	"scripts": {
		"dev": "vite dev --host",
		"build": "npm run prebuild && vite build",
		"prebuild": "rm -f yarn.lock .yarnrc.yml .yarnrc && rm -rf .yarn",
		"preview": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "npm run dev"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-netlify": "^5.0.2",
		"@sveltejs/kit": "^2.22.2",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"svelte": "^5.35.4",
		"svelte-check": "^4.2.2",
		"typescript": "^5.8.3",
		"vite": "^5.4.19"
	},
	"keywords": [
		"game",
		"bible",
		"tetris",
		"word-game",
		"svelte",
		"typescript"
	],
	"author": "Biblical Word Tetris Team",
	"license": "MIT",
	"engines": {
		"node": ">=18.19.0",
		"npm": ">=10.0.0"
	},
	"packageManager": "npm@10.9.2"
}
